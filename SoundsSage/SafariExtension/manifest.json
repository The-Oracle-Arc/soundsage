{
  "manifest_version": 3,
  "name": "Sounds Sage",
  "description": "Mute or pause webpage media in Safari. Does not control native apps.",
  "version": "1.0.0",
  "permissions": ["activeTab"],
  "host_permissions": [],
  "action": {
    "default_title": "Sounds Sage"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
